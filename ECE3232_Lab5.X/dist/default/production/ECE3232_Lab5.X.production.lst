  1652                           ;	RSTOSC = HFINT1, HFINTOSC (1MHz)
  1653                           ;	Clock Out Enable bit
  1654                           ;	CLKOUTEN = OFF, CLKOUT function is disabled; i/o or oscillator function on OSC2
